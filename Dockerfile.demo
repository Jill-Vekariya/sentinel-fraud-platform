FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 \
    DATA_DIR=/tmp/sentinel-data MODEL_DIR=/app/models REDIS_URL="" \
    FRAUD_ENV=production PORT=10000
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-linux-py312.lock ./
RUN pip install --no-cache-dir --require-hashes -r requirements-linux-py312.lock
COPY fraud ./fraud
COPY web ./web
COPY scripts/serve_demo.py ./scripts/serve_demo.py
# Build only trusted synthetic artifacts; no training or downloads at service startup.
RUN python -m fraud.train --n 12000 --seed 42 --promote > /app/model-build-report.json \
    && useradd --uid 10001 --create-home sentinel
COPY deploy/image-source.json /app/image-source.json
LABEL io.sentinel.purpose="synthetic-ephemeral-demo"
USER 10001:10001
EXPOSE 10000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.getenv('PORT','10000')+'/health/ready',timeout=4)"
CMD ["python", "-m", "scripts.serve_demo"]
